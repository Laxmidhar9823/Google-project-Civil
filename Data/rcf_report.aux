\@writefile{toc}{\contentsline {paragraph}{The target is measuring two different things.}{11}{section*.21}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Neither label is beatable here, for different reasons.}{12}{section*.22}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces \textbf  {Left:} the model's argmax against each paper's reported optimum; MAE~$=14.0$ points over 32 held-out papers, worse than the $8.6$-point mean prior. \textbf  {Right:} why. Each paper's reported optimum plotted against the argmax of its \emph  {own} 28-day strength table---the two disagree by 14.1 points at $r=0.43$, with the reported values systematically higher. The label is not measuring strength maximization.}}{12}{figure.caption.23}\protected@file@percent }
\newlabel{fig:opt}{{8}{12}{\textbf {Left:} the model's argmax against each paper's reported optimum; MAE~$=14.0$ points over 32 held-out papers, worse than the $8.6$-point mean prior. \textbf {Right:} why. Each paper's reported optimum plotted against the argmax of its \emph {own} 28-day strength table---the two disagree by 14.1 points at $r=0.43$, with the reported values systematically higher. The label is not measuring strength maximization}{figure.caption.23}{}}
